<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
                    xmlns:services="clr-namespace:Flowery.Services;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="10">
                <controls:DaisyRadio Content="Radio 1" GroupName="A" />
                <controls:DaisyRadio Content="Radio 2" GroupName="A" IsChecked="True" />
                <controls:DaisyRadio Content="Primary" Variant="Primary" IsChecked="True" GroupName="B" />
                <controls:DaisyRadio Content="Secondary" Variant="Secondary" IsChecked="True" GroupName="C" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:DaisyRadio}" TargetType="controls:DaisyRadio">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyRadioMediumFontSize}" />
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static controls:SelectionControlScale.Instance}">
                <Binding Path="(controls:SelectionControlScale.BaseFontSize)" RelativeSource="{RelativeSource Self}" />
                <Binding Path="(services:FloweryScaleManager.ScaleFactor)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeMediumHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid ColumnDefinitions="Auto,*">
                        <LayoutTransformControl Grid.Column="0" VerticalAlignment="Center"
                            LayoutTransform="{Binding (services:FloweryScaleManager.ScaleFactor), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:SelectionControlScale.Indicator}}">
                            <Border x:Name="PART_Border"
                                    VerticalAlignment="Center"
                                    Width="{DynamicResource DaisyRadioMediumSize}" Height="{DynamicResource DaisyRadioMediumSize}"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DaisyBaseContentBrush}"
                                    Background="{DynamicResource DaisyBase100Brush}">
                                <Ellipse x:Name="CheckMark"
                                         Width="{DynamicResource DaisyRadioDotMediumSize}" Height="{DynamicResource DaisyRadioDotMediumSize}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource DaisyBaseContentBrush}"
                                         IsVisible="False" />
                            </Border>
                        </LayoutTransformControl>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontStyle="{TemplateBinding FontStyle}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Checked State -->
        <Style Selector="^:checked /template/ Ellipse#CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>

        <!-- Focus State -->
        <Style Selector="^:focus /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Variants -->
        <Style Selector="^[Variant=Primary]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Primary]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisyPrimaryBrush}" />
        </Style>

        <Style Selector="^[Variant=Secondary]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisySecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Secondary]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisySecondaryBrush}" />
        </Style>

        <Style Selector="^[Variant=Accent]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Accent]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisyAccentBrush}" />
        </Style>

        <Style Selector="^[Variant=Success]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisySuccessBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Success]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisySuccessBrush}" />
        </Style>

        <Style Selector="^[Variant=Warning]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyWarningBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Warning]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisyWarningBrush}" />
        </Style>

        <Style Selector="^[Variant=Error]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyErrorBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Error]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisyErrorBrush}" />
        </Style>

        <Style Selector="^[Variant=Info]:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyInfoBrush}" />
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        </Style>
        <Style Selector="^[Variant=Info]:checked /template/ Ellipse#CheckMark">
            <Setter Property="Fill" Value="{DynamicResource DaisyInfoBrush}" />
        </Style>

        <!-- Sizes -->
        <Style Selector="^[Size=ExtraSmall]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyRadioExtraSmallFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraSmallHeight}" />
        </Style>
        <Style Selector="^[Size=Small]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyRadioSmallFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeSmallHeight}" />
        </Style>
        <Style Selector="^[Size=Large]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyRadioLargeFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeLargeHeight}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyRadioExtraLargeFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraLargeHeight}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge] /template/ Border#PART_Border">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioExtraLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioExtraLargeSize}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge] /template/ Ellipse#CheckMark">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioDotExtraLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioDotExtraLargeSize}" />
        </Style>
        <Style Selector="^[Size=Large] /template/ Border#PART_Border">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioLargeSize}" />
             <Setter Property="CornerRadius" Value="16" />
        </Style>
         <Style Selector="^[Size=Large] /template/ Ellipse#CheckMark">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioDotLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioDotLargeSize}" />
        </Style>

        <Style Selector="^[Size=Small] /template/ Border#PART_Border">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioSmallSize}" />
             <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="^[Size=Small] /template/ Ellipse#CheckMark">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioDotSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioDotSmallSize}" />
        </Style>

        <Style Selector="^[Size=ExtraSmall] /template/ Border#PART_Border">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioExtraSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioExtraSmallSize}" />
             <Setter Property="CornerRadius" Value="8" />
        </Style>
         <Style Selector="^[Size=ExtraSmall] /template/ Ellipse#CheckMark">
            <Setter Property="Width" Value="{DynamicResource DaisyRadioDotExtraSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyRadioDotExtraSmallSize}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
